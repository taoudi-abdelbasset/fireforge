{
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "api_name",
        "base_url",
        "versions"
    ],
    "properties": {
        "api_name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "base_url": {
            "type": "string",
            "pattern": "^\\$\\{[A-Z0-9_]+:[^\\s]+\\}$|^https?://[^\\s]+$"
        },
        "default_version": {
            "type": "string"
        },
        "default_headers": {
            "type": "object",
            "description": "Global default headers for all endpoints",
            "additionalProperties": {
                "type": "string"
            }
        },
        "timeout": {
            "type": "integer",
            "minimum": 1,
            "default": 30
        },
        "raise_on_error": {
            "type": "boolean",
            "default": true
        },
        "retry": {
            "$ref": "#/$defs/retry"
        },
        "auth": {
            "type": [
                "object",
                "null"
            ],
            "default": null,
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "login_token",
                                "static_token"
                            ]
                        },
                        "login_endpoint": {
                            "type": "object",
                            "properties": {
                                "path": {
                                    "type": "string",
                                    "pattern": "^[^\\s]+$"
                                },
                                "method": {
                                    "type": "string",
                                    "enum": [
                                        "POST",
                                        "GET",
                                        "PUT",
                                        "DELETE",
                                        "PATCH"
                                    ]
                                },
                                "login_body": {
                                    "$ref": "https://json-schema.org/draft/2020-12/schema"
                                },
                                "token_field": {
                                    "type": "string"
                                },
                                "refresh_token_field": {
                                    "type": "string"
                                },
                                "expires_in_field": {
                                    "type": "string"
                                },
                                "timeout": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "default": 30,
                                    "description": "Timeout in seconds for the login request"
                                }
                            },
                            "required": [
                                "path",
                                "method",
                                "token_field"
                            ],
                            "additionalProperties": false
                        },
                        "refresh_endpoint": {
                            "type": "object",
                            "properties": {
                                "path": {
                                    "type": "string",
                                    "pattern": "^[^\\s]+$"
                                },
                                "method": {
                                    "type": "string",
                                    "enum": [
                                        "POST",
                                        "GET",
                                        "PUT",
                                        "DELETE",
                                        "PATCH"
                                    ]
                                },
                                "body_schema": {
                                    "$ref": "https://json-schema.org/draft/2020-12/schema"
                                },
                                "timeout": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "default": 30,
                                    "description": "Timeout in seconds for the login request"
                                }
                            },
                            "required": [
                                "path",
                                "method",
                                "body_schema"
                            ],
                            "additionalProperties": false
                        },
                        "access_key": {
                            "type": "string"
                        },
                        "token_placement": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "header",
                                        "query",
                                        "body"
                                    ],
                                    "default": "header"
                                },
                                "prefix": {
                                    "type": "string"
                                },
                                "token_field_name": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false,
                            "required": [
                                "token_field_name"
                            ]
                        }
                    },
                    "required": [
                        "type",
                        "token_placement"
                    ],
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "type": {
                                        "const": "login_token"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "login_endpoint"
                                ]
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "type": {
                                        "const": "static_token"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "access_key"
                                ]
                            }
                        }
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "required": [
                    "version_name",
                    "endpoints"
                ],
                "properties": {
                    "version_name": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]+$"
                    },
                    "endpoints": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "object",
                            "required": [
                                "function_name",
                                "path",
                                "method"
                            ],
                            "properties": {
                                "function_name": {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z0-9_-]+$"
                                },
                                "path": {
                                    "type": "string",
                                    "pattern": "^/[^\\s]*(?:\\{[a-zA-Z0-9_-]+\\}[^\\s]*)*$"
                                },
                                "method": {
                                    "type": "string",
                                    "enum": [
                                        "GET",
                                        "POST",
                                        "PUT",
                                        "DELETE",
                                        "PATCH"
                                    ]
                                },
                                "auth_required": {
                                    "type": "boolean",
                                    "default": true
                                },
                                "body_required": {
                                    "type": "boolean",
                                    "default": false
                                },
                                "params_schema": {
                                    "$ref": "https://json-schema.org/draft/2020-12/schema"
                                },
                                "raise_on_error": {
                                    "type": "boolean",
                                    "default": true
                                },
                                "timeout": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "retry": {
                                    "$ref": "#/$defs/retry"
                                },
                                "override_default_headers": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "If true, ignore global default_headers and use only endpoint-specific headers"
                                },
                                "headers": {
                                    "type": "object",
                                    "description": "Endpoint-specific headers (merged with global defaults). Supports environment variables like ${VAR:default}",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "request_body": {
                                    "type": "object",
                                    "description": "Request body configuration",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "json",
                                                "form_data",
                                                "urlencoded",
                                                "raw",
                                                "none"
                                            ],
                                            "default": "json",
                                            "description": "Body serialization type"
                                        },
                                        "content_type": {
                                            "type": "string",
                                            "description": "Content-Type header for raw bodies (e.g., text/xml, text/csv, text/plain)"
                                        },
                                        "fields": {
                                            "type": "object",
                                            "description": "Field definitions for form_data or urlencoded bodies",
                                            "patternProperties": {
                                                "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                                                    "type": "object",
                                                    "properties": {
                                                        "field_type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "text",
                                                                "file"
                                                            ],
                                                            "default": "text",
                                                            "description": "Whether this is a text field or file field"
                                                        },
                                                        "content_type": {
                                                            "type": "string",
                                                            "description": "Content-Type for this specific field (optional, auto-detected if not set)"
                                                        },
                                                        "required": {
                                                            "type": "boolean",
                                                            "default": false,
                                                            "description": "Whether this field is required"
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "description": "Human-readable description of this field"
                                                        },
                                                        "multiple": {
                                                            "type": "boolean",
                                                            "default": false,
                                                            "description": "Whether multiple files are allowed (file fields only)"
                                                        },
                                                        "allowed_extensions": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string",
                                                                "pattern": "^\\.[a-zA-Z0-9]+$"
                                                            },
                                                            "description": "Allowed file extensions like .pdf, .jpg (file fields only)"
                                                        },
                                                        "max_file_size": {
                                                            "type": "integer",
                                                            "minimum": 1,
                                                            "description": "Maximum file size in bytes (file fields only)"
                                                        }
                                                    },
                                                    "additionalProperties": false,
                                                    "allOf": [
                                                        {
                                                            "if": {
                                                                "properties": {
                                                                    "field_type": {
                                                                        "const": "text"
                                                                    }
                                                                }
                                                            },
                                                            "then": {
                                                                "not": {
                                                                    "anyOf": [
                                                                        {
                                                                            "required": [
                                                                                "multiple"
                                                                            ]
                                                                        },
                                                                        {
                                                                            "required": [
                                                                                "allowed_extensions"
                                                                            ]
                                                                        },
                                                                        {
                                                                            "required": [
                                                                                "max_file_size"
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        "max_total_size": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "description": "Maximum total size for all files in bytes"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "allOf": [
                                        {
                                            "if": {
                                                "properties": {
                                                    "type": {
                                                        "const": "raw"
                                                    }
                                                }
                                            },
                                            "then": {
                                                "required": [
                                                    "content_type"
                                                ]
                                            }
                                        },
                                        {
                                            "if": {
                                                "properties": {
                                                    "type": {
                                                        "enum": [
                                                            "form_data",
                                                            "urlencoded"
                                                        ]
                                                    }
                                                }
                                            },
                                            "then": {
                                                "required": [
                                                    "fields"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "retry": {
            "type": "object",
            "properties": {
                "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 3
                },
                "delay": {
                    "type": "number",
                    "minimum": 0,
                    "default": 1.0
                },
                "backoff_factor": {
                    "type": "number",
                    "minimum": 0,
                    "default": 2.0
                },
                "jitter": {
                    "type": "boolean",
                    "default": true
                }
            },
            "additionalProperties": false
        }
    }
}